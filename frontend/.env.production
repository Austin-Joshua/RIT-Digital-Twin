# Production / Vercel: set these in Vercel Dashboard → Project → Settings → Environment Variables
# Use your ngrok or deployed backend URL (no trailing slash).
#
# Option A – set both:
# VITE_API_BASE_URL=https://roguish-christee-cnemial.ngrok-free.dev/api
# VITE_WEBSOCKET_URL=https://roguish-christee-cnemial.ngrok-free.dev/ws
#
# Option B – set single base (app derives /api and /ws):
# VITE_BACKEND_URL=https://roguish-christee-cnemial.ngrok-free.dev
#
# Then:
# VITE_ENABLE_WEBSOCKET=true
# VITE_ENABLE_ANALYTICS=true

VITE_API_BASE_URL=https://roguish-christee-cnemial.ngrok-free.dev/api
VITE_WEBSOCKET_URL=https://roguish-christee-cnemial.ngrok-free.dev/ws
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_ANALYTICS=true
