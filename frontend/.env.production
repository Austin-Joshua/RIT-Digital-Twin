# Production / Vercel Environment Variables
# ============================================================
# Do NOT set VITE_API_BASE_URL here to a static URL.
# Instead, set it in the Vercel Dashboard:
#   Project → Settings → Environment Variables
#
# Set:
#   VITE_API_BASE_URL  = https://YOUR-RENDER-APP.onrender.com/api
#   VITE_WEBSOCKET_URL = https://YOUR-RENDER-APP.onrender.com/ws
#   VITE_ENABLE_WEBSOCKET = true
#   VITE_ENABLE_ANALYTICS = true
#
# Replace YOUR-RENDER-APP with your actual Render service name.
# Example: https://rit-digital-twin-backend.onrender.com/api
# ============================================================

VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_ANALYTICS=true
