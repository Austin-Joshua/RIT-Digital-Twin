# Production Environment for Vercel
# Configure these values in Vercel dashboard under Project Settings > Environment Variables
# 
# IMPORTANT: The backend domain MUST be accessible from Vercel (HTTPS recommended)
#           and have CORS configured to allow your Vercel domain

# Replace 'your-backend-domain.com' with your actual backend domain
# Examples:
# - https://api.yourdomain.com
# - https://backend.railway.app  
# - https://your-app.deno.dev
# - https://your-app.onrender.com

VITE_API_BASE_URL=https://your-backend-domain.com/api
VITE_WEBSOCKET_URL=https://your-backend-domain.com/ws
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_WEBSOCKET=true
