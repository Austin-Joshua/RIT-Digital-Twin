# ---- Backend (Spring Boot) - Local Development ----
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/rit_digital_twin?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
APP_JWT_SECRET=64a7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7

# ---- Frontend (Vite) - Local Dev ----
# Uses Vite proxy to backend (localhost:8080) — no full URL needed locally
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WEBSOCKET_URL=http://localhost:8080/ws
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_ANALYTICS=true

# ---- Deployment ----
COMPOSE_PROJECT_NAME=rit-digital-twin
