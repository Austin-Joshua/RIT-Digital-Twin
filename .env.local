# RIT Digital Twin - Frontend Environment Configuration
# Local Development & Vercel Deployment

# ========================================
# API Configuration
# ========================================
# For Local Development (Backend on localhost:8080)
VITE_API_BASE_URL=http://localhost:8080/api

# For Vercel Production (Backend endpoint) - use when deploying
# VITE_API_BASE_URL=/api

# Development Fallback (if not set, falls back to localhost:8080/api)
# Development mode will use proxy configuration in vite.config.js

# ========================================
# Feature Flags
# ========================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_WEBSOCKET=true
VITE_WEBSOCKET_URL=http://localhost:8080/ws

# ========================================
# App Configuration
# ========================================
VITE_APP_NAME=RIT Digital Twin
VITE_INSTITUTION=Rajalakshmi Institute of Technology, Chennai
