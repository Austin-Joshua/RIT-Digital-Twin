# Root .env.production
# Used only if Vite is run from project root (rare).
# Keep in sync with frontend/.env.production
# ============================================================
# Set VITE_API_BASE_URL in Vercel Dashboard → Project → Settings → Environment Variables
# Example value: https://YOUR-RAILWAY-APP.up.railway.app/api
# ============================================================

VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_ANALYTICS=true
