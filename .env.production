# RIT Digital Twin - Vercel Production Environment
# Set these variables in Vercel dashboard for production deployment

# ========================================
# Production API Configuration  
# ========================================
# Replace with your actual backend API endpoint
# This should point to your Spring Boot backend (local, cloud, or server)
# VITE_API_BASE_URL=https://your-backend-domain.com/api

# For local backend testing through Vercel:
# VITE_API_BASE_URL=http://localhost:8080/api

# ========================================
# WebSocket Configuration
# ========================================
# VITE_WEBSOCKET_URL=http://localhost:8080/ws

# ========================================
# Feature Flags for Production
# ========================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_WEBSOCKET=true

# ========================================
# Notes for Vercel Deployment
# ========================================
# 1. Configure these variables in Vercel Project Settings → Environment Variables
# 2. Keep secrets (JWT tokens, API keys) in Vercel's environment only
# 3. The frontend will auto-detect environment at build time
# 4. CORS is already configured in backend for *.vercel.app domains
# 5. WebSocket requires same domain or explicit CORS configuration
