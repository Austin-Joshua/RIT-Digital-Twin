# Digital Twin - Smart Campus Intelligence Platform
# Environment Configuration Template
# Copy this file to .env and update with your values

# ==========================================
# Database Configuration
# ==========================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=digital_twin
MYSQL_USER=dt_user
MYSQL_PASSWORD=dt_secure_password_2026

# ==========================================
# JWT Configuration
# ==========================================
# Generate a strong secret (min 32 characters)
APP_JWT_SECRET=DigitalTwinSmartCampusIntelligencePlatformSecretKey2026VeryLongSecureKeyForProduction
APP_JWT_EXPIRATION_MS=86400000

# ==========================================
# CORS Configuration
# ==========================================
# For Local Development
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80,http://localhost

# For Production (Vercel + Render)
# APP_CORS_ALLOWED_ORIGINS=https://digital-twin-lemon.vercel.app,https://digital-twin-phi.vercel.app,https://*.vercel.app

# ==========================================
# Backend Configuration
# ==========================================
# Local Backend URL (for development)
BACKEND_URL=http://localhost:8080

# Production Backend URL (for Vercel deployment)
# BACKEND_URL=https://rit-digital-twin.onrender.com

# ==========================================
# Frontend Configuration
# ==========================================
# Local Development - API calls go through Vite proxy
VITE_API_BASE_URL=/api

# Production (Vercel) - API calls go through Vercel rewrites
# VITE_API_BASE_URL=/api
# Note: Vercel's vercel.json will rewrite /api/* to the backend URL

# ==========================================
# Backend (Spring Boot) Configuration
# ==========================================
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/rit_digital_twin?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
BACKEND_PORT=8080

# ==========================================
# Spring Profiles
# ==========================================
# Options: dev, prod
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# Optional: Email Configuration
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@domain.com
# SMTP_PASSWORD=your_app_password
