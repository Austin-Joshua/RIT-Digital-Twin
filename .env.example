# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rit_digital_twin
DB_USER=ritapp
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_ROOT_PASSWORD=CHANGE_ME_root_password_here

# ─── Backend ─────────────────────────────────────────────────
BACKEND_PORT=8080
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
SPRING_PROFILES_ACTIVE=dev

# ─── Frontend ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api
VITE_APP_NAME=RIT Digital Twin
VITE_GOOGLE_MAPS_API_KEY=CHANGE_ME_your_google_maps_key

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
