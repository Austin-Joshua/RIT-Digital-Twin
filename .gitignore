target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar

# ─── Node / Frontend ─────────────────────────────────────────
node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo

# ─── IDEs ────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo

